---
import IconRss from "@/assets/icons/IconRss.svg";
import Socials from "./Socials.astro";
import config from "@/config";
import { useTranslations } from "@/i18n";

const { socials } = config;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<section id="hero" class="border-border border-b pt-8 pb-6">
  <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
    Hello,
    <br />
    I'm Nuwan Karunarathna
  </h1>
  <a
    target="_blank"
    href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
    class="inline-block"
    aria-label="RSS Feed"
    title="RSS Feed"
  >
    <IconRss
      width={20}
      height={20}
      class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
    />
    <span class="sr-only">RSS Feed</span>
  </a>

  <p>
    Software engineer by profession, builder by nature. I'm passionate about web/backend engineering, AI-assisted development, and creating thoughtful products that solve real-world problems.
  </p>
  {
    socials.length > 0 && (
      <div class="mt-4 flex max-sm:flex-col sm:items-center">
        <div class="text-foreground me-2 mb-1 whitespace-nowrap sm:mb-0">
          {t.home.socialLinks}:
        </div>
        <Socials />
      </div>
    )
  }
</section>
